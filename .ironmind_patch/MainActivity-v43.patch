+    private String compactPrime(String message) {
+        if (message == null) return "READY";
+        String clean = message.replaceAll("[^A-Za-z0-9 ]", " ").replaceAll("\\s+", " ").trim();
+        String[] words = clean.split(" ");
+        if (words.length <= 4) return clean.toUpperCase(Locale.US);
+        StringBuilder out = new StringBuilder();
+        for (String w : words) {
+            String l = w.toLowerCase(Locale.US);
+            if (l.equals("my") || l.equals("the") || l.equals("and") || l.equals("with") || l.equals("into") || l.equals("from")) continue;
+            if (out.length() > 0) out.append(' ');
+            out.append(w);
+            if (out.toString().split(" ").length >= 4) break;
+        }
+        return out.toString().toUpperCase(Locale.US);
+    }
+
+    private String naturalize(String message) {
+        String[] lead = {"Stay with this. ", "Let the body remember. ", "Quietly notice this. ", "One clean idea. ", "Keep it simple. "};
+        return lead[(int)(System.nanoTime() % lead.length + lead.length) % lead.length] + message;
+    }
+
+    private String reverseWords(String text) {
+        String[] words = text.split(" ");
+        StringBuilder out = new StringBuilder();
+        for (int i = words.length - 1; i >= 0; i--) { if (out.length() > 0) out.append(' '); out.append(words[i]); }
+        return out.toString();
+    }
+
+    private long passiveDelayMs(String spacing, int cycle) {
+        if (spacing.startsWith("Golden")) return cycle % 2 == 0 ? 5200L : 8400L;
+        if (spacing.contains("5")) return 5000L;
+        if (spacing.contains("13")) return 13000L;
+        if (spacing.contains("8")) return 8000L;
+        long[] varied = {5200L, 6800L, 8400L, 6100L, 9900L};
+        return varied[cycle % varied.length];
+    }
+
