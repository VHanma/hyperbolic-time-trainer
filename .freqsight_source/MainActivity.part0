public final class MainActivity extends AppCompatActivity implements
        SensorHub.Listener, AudioEngine.Listener, FrameAnalyzer.Listener,
        CameraLockController.Listener, BeaconEngine.Listener {

    private static final int BG=0xFF05080D, PANEL=0xFF0B131C, CYAN=0xFF59E6FF, MUTED=0xFFA5B4C2, ALERT=0xFFFFC857;
    private final ExecutorService cameraExecutor=Executors.newSingleThreadExecutor();
    private final ExecutorService ioExecutor=Executors.newSingleThreadExecutor();

    private PreviewView previewView;
    private ImageView processedView;
    private View beaconFlash;
    private TextView statusView, metricsView, evidenceView, modeView, metadataView, recordingView;
    private ProcessCameraProvider cameraProvider;
    private Camera camera;
    private VideoCapture<Recorder> videoCapture;
    private Recording recording;
    private SensorHub sensors;
    private AudioEngine audio;
    private FrameAnalyzer analyzer;
    private EvidenceEngine evidence;
    private SessionLogger logger;
    private CameraLockController cameraLock;
    private BeaconEngine beacon;
    private TextRecognizer textRecognizer;
    private boolean liveWatch, ocrEnabled, glyphEnabled, sessionActive;
    private long lastOcrMs;
    private DataModels.SensorSnapshot latestSensor=new DataModels.SensorSnapshot();
    private DataModels.AudioSnapshot latestAudio=new DataModels.AudioSnapshot();
    private DataModels.VisualEvent latestVisual;
    private final List<Long> environmentalEventTimes=new ArrayList<>();
    private String beaconState="passive";

    private final ActivityResultLauncher<String[]> permissionLauncher=registerForActivityResult(
            new ActivityResultContracts.RequestMultiplePermissions(), result -> {
                Boolean cameraGranted=result.get(Manifest.permission.CAMERA);
                if(Boolean.TRUE.equals(cameraGranted))bindCamera();
                if(Boolean.TRUE.equals(result.get(Manifest.permission.RECORD_AUDIO)))audio.startListening();
            });

    @Override protected void onCreate(Bundle savedInstanceState){
        super.onCreate(savedInstanceState);
        getWindow().setStatusBarColor(BG);getWindow().setNavigationBarColor(BG);
        sensors=new SensorHub(this,this);
        audio=new AudioEngine(this,this);
        evidence=new EvidenceEngine();
        logger=new SessionLogger(this);
        cameraLock=new CameraLockController(this);
        analyzer=new FrameAnalyzer(sensors,this);
        beacon=new BeaconEngine(audio,this);
        textRecognizer=TextRecognition.getClient(TextRecognizerOptions.DEFAULT_OPTIONS);
        buildUi();
        sensors.start();
        ensurePermissions();
    }

    private void ensurePermissions(){
        List<String> missing=new ArrayList<>();
        if(ContextCompat.checkSelfPermission(this,Manifest.permission.CAMERA)!=PackageManager.PERMISSION_GRANTED)missing.add(Manifest.permission.CAMERA);
        if(ContextCompat.checkSelfPermission(this,Manifest.permission.RECORD_AUDIO)!=PackageManager.PERMISSION_GRANTED)missing.add(Manifest.permission.RECORD_AUDIO);
        if(missing.isEmpty()){bindCamera();audio.startListening();}
        else permissionLauncher.launch(missing.toArray(new String[0]));
    }

    private void buildUi(){
        LinearLayout root=new LinearLayout(this);root.setOrientation(LinearLayout.VERTICAL);root.setBackgroundColor(BG);root.setPadding(dp(10),dp(8),dp(10),dp(8));
        TextView title=text("FREQSIGHT",26,Color.WHITE,true);title.setGravity(Gravity.CENTER);root.addView(title,lp(-1,-2,0));
        TextView creed=text("NO MESSAGE WITHOUT A MARK • NO WORD WITHOUT A WAVEFORM • NO ENGLISH WITHOUT EVIDENCE",11,CYAN,true);creed.setGravity(Gravity.CENTER);creed.setPadding(4,2,4,8);root.addView(creed,lp(-1,-2,0));

        FrameLayout cameraFrame=new FrameLayout(this);cameraFrame.setBackgroundColor(Color.BLACK);
        previewView=new PreviewView(this);previewView.setImplementationMode(PreviewView.ImplementationMode.COMPATIBLE);cameraFrame.addView(previewView,new FrameLayout.LayoutParams(-1,-1));
        processedView=new ImageView(this);processedView.setScaleType(ImageView.ScaleType.FIT_CENTER);processedView.setVisibility(View.GONE);cameraFrame.addView(processedView,new FrameLayout.LayoutParams(-1,-1));
        beaconFlash=new View(this);beaconFlash.setBackgroundColor(Color.argb(130,220,250,255));beaconFlash.setVisibility(View.GONE);cameraFrame.addView(beaconFlash,new FrameLayout.LayoutParams(-1,-1));
        modeView=text("RAW CAMERA",12,CYAN,true);modeView.setBackgroundColor(0x99000000);FrameLayout.LayoutParams mlp=new FrameLayout.LayoutParams(-2,-2,Gravity.TOP|Gravity.LEFT);mlp.setMargins(dp(8),dp(8),0,0);cameraFrame.addView(modeView,mlp);
        recordingView=text("",12,Color.RED,true);recordingView.setBackgroundColor(0x99000000);FrameLayout.LayoutParams rlp=new FrameLayout.LayoutParams(-2,-2,Gravity.TOP|Gravity.RIGHT);rlp.setMargins(0,dp(8),dp(8),0);cameraFrame.addView(recordingView,rlp);
        root.addView(cameraFrame,lp(-1,0,1.2f));

        statusView=text("Set the phone completely still, then calibrate.",15,Color.WHITE,true);statusView.setBackgroundColor(PANEL);statusView.setPadding(dp(10),dp(8),dp(10),dp(8));root.addView(statusView,lp(-1,-2,0));
        metricsView=text("Awaiting sensor stream…",11,MUTED,false);metricsView.setMaxLines(3);root.addView(metricsView,lp(-1,-2,0));
        metadataView=text("Camera controls not locked.",11,MUTED,false);metadataView.setMaxLines(2);root.addView(metadataView,lp(-1,-2,0));
        evidenceView=text("NO TRANSLATABLE DATA.",13,ALERT,true);evidenceView.setBackgroundColor(0xFF071019);evidenceView.setPadding(dp(10),dp(8),dp(10),dp(8));evidenceView.setMaxLines(6);root.addView(evidenceView,lp(-1,-2,0));

        ScrollView controlsScroll=new ScrollView(this);HorizontalScrollView horizontal=new HorizontalScrollView(this);LinearLayout controls=new LinearLayout(this);controls.setOrientation(LinearLayout.HORIZONTAL);horizontal.addView(controls);controlsScroll.addView(horizontal);
        addButton(controls,"CALIBRATE BASELINE",v->calibrate());
        addButton(controls,"BEGIN LIVE WATCH",v->beginWatch());
        addButton(controls,"DIFFERENCE MAP",v->setFilter(FilterMode.DIFFERENCE_HEAT));
        addButton(controls,"SMOKE MAP",v->setFilter(FilterMode.SMOKE_ENHANCE));
        addButton(controls,"SHADOW MAP",v->setFilter(FilterMode.SHADOW_ISOLATE));
        addButton(controls,"REFLECTION MAP",v->setFilter(FilterMode.REFLECTION_ISOLATE));
        addButton(controls,"EM GLYPH CAPTURE",v->toggleGlyph());
        addButton(controls,"LIVE OCR",v->toggleOcr());
        addButton(controls,"RECORD SESSION",v->toggleRecording());
        addButton(controls,"FILTERS",v->showFilterDialog());
        addButton(controls,"FREQUENCY CALIBRATION",v->showFrequencyDialog());
        addButton(controls,"SKYWATCHER BEACON",v->showBeaconDialog());
        addButton(controls,"EXPORT TRANSCRIPT",v->exportTranscript());
        root.addView(controlsScroll,lp(-1,dp(82),0));
        setContentView(root);
    }

    private void bindCamera(){
        ListenableFuture<ProcessCameraProvider> future=ProcessCameraProvider.getInstance(this);
        future.addListener(()->{
            try{
                cameraProvider=future.get();cameraProvider.unbindAll();
                Preview preview=new Preview.Builder().build();preview.setSurfaceProvider(previewView.getSurfaceProvider());
                ImageAnalysis.Builder ab=new ImageAnalysis.Builder().setBackpressureStrategy(ImageAnalysis.STRATEGY_KEEP_ONLY_LATEST);
                cameraLock.attachCaptureCallback(ab,cameraExecutor);
                ImageAnalysis analysis=ab.build();analysis.setAnalyzer(cameraExecutor,analyzer);
                Recorder recorder=new Recorder.Builder().setQualitySelector(QualitySelector.from(Quality.HD, FallbackStrategy.lowerQualityOrHigherThan(Quality.SD))).build();
                videoCapture=VideoCapture.withOutput(recorder);
                camera=cameraProvider.bindToLifecycle(this,CameraSelector.DEFAULT_BACK_CAMERA,preview,analysis,videoCapture);
                status("Camera ready. Keep the phone fixed and calibrate.");
            }catch(Exception e){status("Camera start failed: "+e.getMessage());}
        },ContextCompat.getMainExecutor(this));
    }

