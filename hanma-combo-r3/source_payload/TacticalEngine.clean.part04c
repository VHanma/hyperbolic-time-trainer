pty())return "rival rebuilds stance";Action a=p.get(p.size()-1);String[] replies;if(a.role.equals("TAKEDOWN"))replies=new String[]{"POST","WHIZZER","SCRAMBLE"};else if(a.role.equals("ANGLE"))replies=new String[]{"TURN","FIRE BACK","PULL"};else if(a.target.equals("BODY"))replies=new String[]{"SHELL","PULL","FIRE BACK"};else if(a.target.equals("HEAD"))replies=new String[]{"SHELL","PULL","FIRE BACK","SHOOT"};else replies=new String[]{"FIRE BACK","PULL","SHOOT"};String q=replies[rnd.nextInt(replies.length)];if(q.equals("POST")||q.equals("WHIZZER")||q.equals("TURN"))q="FIRE BACK";queuedReaction=q;reactionBeliefs.put(q,reactionBeliefs.getOrDefault(q,0)+1);return q.equals("FIRE BACK")?"rival tries immediate return fire":q.equals("SHOOT")?"rival changes level under the exit":q.equals("SHELL")?"rival compresses into high guard":q.equals("PULL")?"rival pulls range and waits to counter":"rival scrambles for position";}
