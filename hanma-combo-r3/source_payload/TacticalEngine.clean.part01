at.NONE||(lastDefense!=null&&lastDefense.threat==lastThreat);} public boolean lastPlanHasLoop(){Set<String>s=new HashSet<>();for(Action a:lastPlan)if(!s.add(a.name))return true;for(int i=2;i<lastPlan.size();i++)if(lastPlan.get(i).name.equals(lastPlan.get(i-2).name))return true;return false;}public int lastPlanMorphCount(){int n=0;for(Action a:lastPlan)if("MORPH".equals(a.role))n++;return n;}

    public static String toSpeech(String raw){if(raw==null)return "";String s=raw.replace("/R/"," slip right ").replace("/L/"," slip left ").replace("←"," slip left ").replace("→",", then ").replace("➜",", then ").replace("➡",", then ").replace("1-2","one two").replace("Ω","Omega").replace("•",", ");return s.replaceAll("\\s+"," ").replaceAll("\\s+,",",").replaceAll(",\\s*,+",", ").trim();}

    private void resetRoundState(){st=new SimState();st.range=parseRange(cfg.startRange);exchange=0;lastThreat=Threat.NONE;lastDefense=null;lastPlan=Collections.emptyList();queuedReaction="UNKNOWN";lastPattern="UNSET";lastShard="UNTRACKED";recentPlans.clear();recentActions.clear();recentFamilies.clear();recentSources.clear();}
    private Range parseRange(String r){if(r==null)return Range.BOXING;String x=r.toLowerCase(Locale.US);if(x.contains("long"))return Range.LONG;if(x.contains("pocket"))return Range.POCKET;if(x.contains("clinch"))return Range.CLINCH;if(x.contains("ground"))return Range.BOTTOM;if(x.contains("top"))return Range.TOP_CONTROL;return Range.BOXING;}
    private void addD(Threat t,String n,Range r,Side l,int b,int g,String m,String src){defenses.computeIfAbsent(t,k->new ArrayList<>()).add(new Defense(t,n,r,l,b,g,m,src));}

