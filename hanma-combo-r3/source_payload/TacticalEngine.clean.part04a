Range.LONG,320);addE(es,Threat.TEEP,"Opponent spears a teep into center",Range.LONG,270);}if(cfg.opponent.contains("Pressure")||cfg.opponent.contains("Blitz")){addE(es,Threat.DOUBLE_JAB,"Opponent storms behind a double jab",Range.BOXING,235);addE(es,Threat.OVERHAND,"Opponent crowds behind an overhand",Range.POCKET,250);}
        if(es.isEmpty()){String dl=cfg.discipline.toLowerCase(Locale.US);if(dl.contains("wrestling")||dl.contains("no-gi")){st.range=Range.CLINCH;addE(es,Threat.COLLAR_TIE,"Opponent establishes a neutral collar tie",Range.CLINCH,300);}else{st.range=Range.BOXING;addE(es,Threat.JAB,"Opponent probes with a jab",Range.BOXING,220);}}return es.get(rnd.nextInt(es.size()));
    }
    private void addE(List<Event>es,Threat t,String text,Range r,int w){if(threatLegal(t))es.add(new Event(t,text,r,w));}
    private Event reactionEvent(String q){if(q.equals("FIRE BACK"))return rnd.nextBoolean()?new Event(Threat.CROSS,"Opponent fires back with a rear cross",Range.BOXING,220):new Event(Threat.HOOK_LEAD,"Opponent fires a lead hook on your exit",Range.POCKET,210);if(q.equals("SHOOT"))return new Event(Threat.DOUBLE_LEG,"Opponent answers the exchange by changing level",Range.SHOT,350);if(q.equals("CLINCH"))return new Event(Threat.COLLAR_TIE,"Opponent crashes into a collar tie",Range.CLINCH,300);if(q.equals("SCRAMBLE"))return new Event(Threat.SCRAMBLE_UP,"Opponent uses the opening to scramble upright",Range.SCRAMBLE,360);if(q.equals("PULL"))return new Event(Threat.CROSS,"Opponent pulls then fires the rear hand",Range.BOXING,235);if(q.equals("SHELL"))return new Event(Threat.JAB,"Opponent emerges from the shell with a jab",Range.BOXING,215);return null;}

    private String choosePurpose(Event e){if(e.threat==Threat.DOUBLE_LEG||e.threat==Threat.SINGLE_LEG||e.threat==Threat.CAGE_SHOT)return "DENY ENTRY";if(isSubmission(e.threat))return "SURVIVE → REGAIN STRUCTURE";if(e.threat==Threat.HIP_ESCAPE||e.threat==Threat.WALL_WALK||e.threat==Threat.SCRAMBLE_UP)return "KEEP CONTROL → DENY ESCAPE";if(st.initiative<-2)return "INTERCEPT → TAKE INITIATIVE";String[] cycle={"PROBE","OCCUPY","CONDITION","EXPLOIT","ADAPT"};String p=cycle[exchange%cycle.length];if("Condition & Betray".equals(cfg.mode)&&(exchange%4==2||exchange%4==3))p=exchange%4==2?"CONDITION":"BETRAY EXPECTATION";if("Pressure Hunt".equals(cfg.mode))p="TAKE SPACE → DAMAGE";if("Ringcraft Round".equals(cfg.mode))p="WIN ANGLE → EXIT SAFE";if("Biomechanics Lab".equals(cfg.mode))p="CLEAN MECHANICS → RECOVER";return p;}
    private boolean isSubmission(Threat t){return t==Threat.GUILLOTINE||t==Threat.RNC||t==Threat.ARMBAR||t==Threat.TRIANGLE||t==Threat.KIMURA||t==Threat.BACK_CONTROL||t==Threat.MOUNT_BOTTOM||t==Threat.SIDE_CONTROL_BOTTOM;}

    private int loadedBonus(Action a,SimState s){if(a.side==Side.CENTER||s.loaded==Side.CENTER)return 3;return a.side==s.loaded?18:-12;}
    private boolean positionalLegal(Action a,SimState s){if(!disciplineAllowsDomain(cfg.discipline,a.domain))return false;if(a.start!=s.range){if((s.range==Range.BOXING&&a.start==Range.POCKET)||(s.range==Range.POCKET&&a.start==Range.BOXING)){}else return false;}if(s.range==Range.BOTTOM&&(a.role.equals("DAMAGE")||a.role.equals("TAKEDOWN")||a.role.equals("ISOLATE")))return false;if((s.range==Range.TOP_CONTROL||s.range==Range.TOP_GUARD)&&a.role.equals("ESCAPE"))return false;return true;}
    private int recentPenalty(Action a){int p=0;for(String x:recentActions)if(x.equals(a.name))p+=18;for(String x:recentFamilies)if(x.equals(a.family))p+=5;for(String x:recentSources)if(x.equals(a.source))p+=2;return p;}
    private int doctrineBonus(Action a){if(cfg.doctrine==null||cfg.doctrine.startsWith("Ω"))return 0;return a.source.equals(cfg.doctrine)?26:-2;}
    private int profileBonus(Action a){String p=cfg.profile.toLowerCase(Locale.US),n=a.name.toLowerCase(Locale.US);int b=0;if(p.contains("topuria")&&(a.family.equals("CROSS")||a.family.equals("HOOK")||a.domain.equals("WRESTLING")))b+=10;if(p.contains("mcgregor")&&(n.contains("cross")||a.domain.equals("KARATE")||a.role.equals("INTERCEPT")))b+=9;if(p.contains("gaethje")&&(a.family.equals("LOWKICK")||a.source.contains("Wittman")))b+=12;if(p.contains("gsp")&&(a.domain.equals("WRESTLING")||a.family.equals("JAB")))b+=10;if(p.contains("pereira")&&(a.family.equals("HOOK")||a.family.equals("LOWKICK")))b+=10;if(p.contains("benny")&&a.source.contains("Benny"))b+=14;if(p.contains("52")&&a.domain.equals("52"))b+=16;if(p.contains("musashi")&&(a.role.equals("DRAW")||a.role.equals("INTERCEPT")))b+=8;return b;}
    private int counterfactualScore(Action a){int shell=0,pull=0,shoot=0,fire=0;if(a.target.equals("BODY"))shell+=7;if(a.target.equals("HEAD")&&(a.role.equals("DAMAGE")||a.role.equals("FINISH")))shell-=6;if(a.role.equals("ANGLE")){pull+=4;fire+=9;shoot+=3;}if(a.