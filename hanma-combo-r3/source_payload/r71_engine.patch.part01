+    private boolean noveltyLegal(Action a,List<Action> out){
+        int morphs=0;
+        for(Action prior:out){
+            if(prior.name.equals(a.name)) return false; // exact repeats never add information
+            if(prior.role.equals("MORPH")) morphs++;
+        }
+        if(a.role.equals("MORPH") && morphs>0) return false; // one trajectory change per exchange
+        if(out.size()>=2 && out.get(out.size()-2).name.equals(a.name)) return false; // kill A-B-A oscillation
+        return true;
+    }
+
+    private int nextWindow(Action a){
+        if(a.role.equals("PROBE")||a.role.equals("FEINT")||a.role.equals("DRAW")) return 260;
+        if(a.role.equals("ANGLE")||a.role.equals("CONTROL")) return 250;
+        if(a.role.equals("TAKEDOWN")||a.role.equals("ESCAPE")) return 300;
+        if(a.role.equals("MORPH")) return 190;
+        if(a.role.equals("FINISH")) return 180;
+        return 220;
     }
 
