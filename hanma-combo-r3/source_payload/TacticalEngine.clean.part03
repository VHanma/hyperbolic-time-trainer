,5,4,250,"ESCAPE","POSTURE","SCRAMBLE");addA(D,"GRAPPLE","pass to side control",Range.TOP_GUARD,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,5,4,250,"CONTROL","POSTURE","PASS");addA(D,"GRAPPLE","knee-cut pass",Range.TOP_GUARD,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,6,5,260,"CONTROL","POSTURE","PASS");addA(D,"GRAPPLE","body-lock pass",Range.TOP_GUARD,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,7,6,280,"CONTROL","POSTURE","PASS");addA(D,"GRAPPLE","arm triangle setup",Range.TOP_CONTROL,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,6,4,260,"ISOLATE","NECK","SUB");addA(D,"GRAPPLE","rear naked choke setup",Range.TOP_CONTROL,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,7,4,260,"ISOLATE","NECK","SUB");addA(D,"GRAPPLE","kimura trap to back exposure",Range.TOP_CONTROL,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,6,5,260,"ISOLATE","ARM","SUB");addA(D,"GRAPPLE","wrist ride to mat return",Range.TOP_CONTROL,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,5,4,240,"CONTROL","POSTURE","RIDE");
                // MMA / Sambo transition grammar
        addA(M,"MMA","jab-cross to double leg",Range.BOXING,Range.TOP_GUARD,Side.CENTER,Side.CENTER,8,10,290,"TAKEDOWN","BASE","MMA_TRANS");addA(M,"MMA","same-side jab to lead-leg shot",Range.BOXING,Range.SCRAMBLE,Side.CENTER,Side.CENTER,7,8,270,"TAKEDOWN","BASE","MMA_TRANS");addA(F,"MMA","lead hook to body lock",Range.POCKET,Range.CLINCH,Side.CENTER,Side.CENTER,6,5,210,"CONTROL","POSTURE","MMA_TRANS");addA(M,"MMA","low-kick feint to double leg",Range.LONG,Range.TOP_GUARD,Side.CENTER,Side.CENTER,7,9,285,"TAKEDOWN","BASE","MMA_TRANS");addA(M,"MMA","teep feint to level change",Range.LONG,Range.SCRAMBLE,Side.CENTER,Side.CENTER,6,7,260,"TAKEDOWN","BASE","MMA_TRANS");addA(F,"MMA","body jab to collar tie",Range.BOXING,Range.CLINCH,Side.LEAD,Side.CENTER,4,3,175,"CONTROL","POSTURE","MMA_TRANS");addA(M,"MMA","sprawl to rear uppercut",Range.SCRAMBLE,Range.POCKET,Side.REAR,Side.LEAD,6,4,190,"DAMAGE","HEAD","MMA_TRANS");addA(M,"MMA","front headlock knee then spin behind",Range.SCRAMBLE,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,7,6,250,"CONTROL","POSTURE","SCRAMBLE");addA(D,"MMA","whizzer knee and turn",Range.CLINCH,Range.BOXING,Side.REAR,Side.CENTER,5,4,190,"ANGLE","BODY","CLINCH");addA(D,"MMA","underhook elbow on break",Range.CLINCH,Range.POCKET,Side.CENTER,Side.CENTER,5,4,185,"DAMAGE","HEAD","CLINCH");addA(D,"MMA","snapdown to front headlock",Range.CLINCH,Range.SCRAMBLE,Side.CENTER,Side.CENTER,5,4,210,"CONTROL","POSTURE","CLINCH");addA(D,"MMA","double underhook knee tap",Range.CLINCH,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,6,7,250,"TAKEDOWN","BASE","THROW");addA(D,"MMA","inside trip from over-under",Range.CLINCH,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,7,8,270,"TAKEDOWN","BASE","THROW");addA(D,"MMA","outside trip to half guard top",Range.CLINCH,Range.TOP_GUARD,Side.CENTER,Side.CENTER,7,8,270,"TAKEDOWN","BASE","THROW");
        addA(D,"MMA","posture strike to knee-cut pass",Range.TOP_GUARD,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,6,5,250,"CONTROL","POSTURE","TOP_MMA");addA(D,"MMA","wrist pin to short ground strike",Range.TOP_CONTROL,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,5,4,200,"DAMAGE","HEAD","TOP_MMA");addA(D,"MMA","crossface ride to back exposure",Range.TOP_CONTROL,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,5,4,230,"CONTROL","POSTURE","RIDE");addA(D,"MMA","half-nelson ride to mat return",Range.TOP_CONTROL,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,5,4,230,"CONTROL","POSTURE","RIDE");addA(D,"MMA","gift-wrap to back take",Range.TOP_CONTROL,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,6,5,250,"ISOLATE","POSTURE","RIDE");addA(D,"MMA","knee-on-belly pressure switch",Range.TOP_CONTROL,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,5,4,220,"CONTROL","BODY","TOP_MMA");addA(D,"MMA","arm-triangle threaten to mount",Range.TOP_CONTROL,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,6,4,240,"ISOLATE","NECK","SUB");addA(D,"MMA","kimura grip to back take",Range.TOP_CONTROL,Range.TOP_CONTROL,Side.CENTER,Side.CENTER,6,5,250,"ISOLATE","ARM","SUB");addA(D,"MMA","hip-heist to stand",Range.BOTTOM,Range.BOXING,Side.CENTER,Side.CENTER,4,3,240,"ESCAPE","SPACE","ESCAPE");addA(D,"MMA","butterfly frame to technical stand",Range.BOTTOM,Range.LONG,Side.CENTER,Side.CENTER,5,4,260,"ESCAPE","SPACE","ESCAPE");addA(D,"MMA","underhook wall-walk to clinch",Range.BOTTOM,Range.CLINCH,Side.CENTER,Side.CENTER,6,5,300,"ESCAPE","SPACE","ESCAPE");addA(D,"MMA","knee shield to wrestle-up",Range.BOTTOM,Range.SCRAMBLE,Side.CENTER,Side.CENTER,5,4,260,"ESCAPE","POSTURE","SCRAMBLE");
