    private boolean disciplineAllowsDomain(String d,String domain){String x=(d==null?"MMA":d).toLowerCase(Locale.US);if(domain.equals("UNIVERSAL"))return true;if(x.contains("boxing only"))return domain.equals("BOXING");if(x.contains("52"))return domain.equals("BOXING")||domain.equals("52");if(x.contains("all striking"))return domain.equals("BOXING")||domain.equals("KICK")||domain.equals("MUAY")||domain.equals("KARATE")||domain.equals("52")||domain.equals("STRIKING");if(x.contains("muay"))return domain.equals("BOXING")||domain.equals("KICK")||domain.equals("MUAY")||domain.equals("STRIKING");if(x.contains("kickboxing"))return domain.equals("BOXING")||domain.equals("KICK")||domain.equals("STRIKING");if(x.contains("karate"))return domain.equals("BOXING")||domain.equals("KARATE")||domain.equals("KICK")||domain.equals("STRIKING");if(x.contains("wrestling"))return domain.equals("WRESTLING");if(x.contains("no-gi"))return domain.equals("WRESTLING")||domain.equals("GRAPPLE");if(x.contains("sambo"))return !domain.equals("52")&& !domain.equals("KARATE");if(x.contains("mma")||x.contains("hybrid"))return true;return true;}
    private boolean threatLegal(Threat t){String d=cfg.discipline.toLowerCase(Locale.US);boolean kick=t==Threat.LOW_KICK||t==Threat.BODY_KICK||t==Threat.HEAD_KICK||t==Threat.TEEP||t==Threat.SIDE_KICK||t==Threat.SPIN_KICK;boolean grapple=t==Threat.DOUBLE_LEG||t==Threat.SINGLE_LEG||t==Threat.ANKLE_PICK||t==Threat.CAGE_SHOT||t==Threat.FRONT_HEADLOCK||t==Threat.GUILLOTINE||t==Threat.BACK_CONTROL||t==Threat.RNC||t==Threat.ARMBAR||t==Threat.TRIANGLE||t==Threat.KIMURA||t==Threat.MOUNT_BOTTOM||t==Threat.SIDE_CONTROL_BOTTOM||t==Threat.HIP_ESCAPE||t==Threat.WALL_WALK||t==Threat.SCRAMBLE_UP;boolean clinch=t==Threat.KNEE||t==Threat.ELBOW||t==Threat.COLLAR_TIE||t==Threat.BODY_LOCK||t==Threat.UNDERHOOK_PIN;if(d.contains("boxing")||d.contains("52"))return !(kick||grapple||clinch);if(d.contains("kickboxing")||d.contains("all striking")||d.contains("karate"))return !grapple&&!clinch;if(d.contains("muay"))return !grapple;if(d.contains("wrestling")||d.contains("no-gi"))return grapple||t==Threat.COLLAR_TIE||t==Threat.BODY_LOCK||t==Threat.UNDERHOOK_PIN;return true;}

    private Event generateEvent(){
        // Reaction continuity first: opponent behavior is partly caused by the previous exchange.
        if(!"UNKNOWN".equals(queuedReaction)&&exchange>1&&rnd.nextInt(100)<58){Event q=reactionEvent(queuedReaction);if(q!=null&&threatLegal(q.threat))return q;}
        List<Event> es=new ArrayList<>();Range r=st.range;
        if(r==Range.BOTTOM){addE(es,Threat.MOUNT_BOTTOM,"Opponent settles into mount",r,520);addE(es,Threat.SIDE_CONTROL_BOTTOM,"Opponent pins side control with crossface",r,520);addE(es,Threat.BACK_CONTROL,"Opponent takes your back and attacks the neck",r,420);addE(es,Threat.RNC,"Opponent threads a rear naked choke",r,300);addE(es,Threat.KIMURA,"Opponent isolates your arm for a kimura",r,360);}else if(r==Range.TOP_GUARD){addE(es,Threat.GUILLOTINE,"Opponent snaps a guillotine as you enter",r,340);addE(es,Threat.ARMBAR,"Opponent throws the legs high for an armbar",r,360);addE(es,Threat.TRIANGLE,"Opponent climbs guard into a triangle",r,350);}else if(r==Range.TOP_CONTROL){addE(es,Threat.HIP_ESCAPE,"Opponent frames your hip and starts a hip escape",r,430);addE(es,Threat.WALL_WALK,"Opponent builds to the fence for a wall walk",r,470);addE(es,Threat.SCRAMBLE_UP,"Opponent turns to knees and scrambles up",Range.SCRAMBLE,390);}else if(r==Range.SCRAMBLE){addE(es,Threat.SCRAMBLE_UP,"Opponent posts and tries to win the scramble upright",r,360);addE(es,Threat.FRONT_HEADLOCK,"Opponent catches your head during the scramble",r,320);addE(es,Threat.SINGLE_LEG,"Opponent clings to a single leg in the scramble",Range.SHOT,360);}else if(r==Range.CLINCH){addE(es,Threat.KNEE,"Opponent frames and drives a knee",r,260);addE(es,Threat.ELBOW,"Opponent swims inside and fires an elbow",r,220);addE(es,Threat.BODY_LOCK,"Opponent locks hands around your body",r,430);addE(es,Threat.UNDERHOOK_PIN,"Opponent pins you with a deep underhook",r,420);addE(es,Threat.CAGE_SHOT,"Opponent drives a takedown against the fence",r,420);}else if(r==Range.LONG){addE(es,Threat.LOW_KICK,"Opponent chops the lead leg",r,280);addE(es,Threat.BODY_KICK,"Opponent whips a rear body kick",r,320);addE(es,Threat.HEAD_KICK,"Opponent fires a high round kick",r,320);addE(es,Threat.TEEP,"Opponent drives a teep down the center",r,270);addE(es,Threat.SIDE_KICK,"Opponent launches a side kick",r,310);addE(es,Threat.SPIN_KICK,"Opponent spins into a back kick",r,420);addE(es,Threat.DOUBLE_JAB,"Opponent storms behind a double jab",Range.BOXING,240);}else{addE(es,Threat.JAB,"Opponent shoots a sharp jab",Range.BOXING,210);addE(es,Threat.DOUBLE_JAB,"Opponent storms behind a double jab",Range.BOXING,240);addE(es,Threat.CROSS,"Opponent commits to a rear cross",Range.BOXING,240);addE(es,Threat.HOOK_LEAD,"Opponent whips a lead hook",Range.POCKET,210);addE(es,Threat.HOOK_REAR,"Opponent whips a rear hook",Range.POCKET,220);addE(es,Threat.UPPERCUT,"Opponent digs an uppercut through center",Range.POCKET,210);addE(es,Threat.OVERHAND,"Opponent crashes in with an overhand",Range.POCKET,260);addE(es,Threat.DOUBLE_LEG,"Opponent changes level for a double leg",Range.SHOT,360);addE(es,Threat.SINGLE_LEG,"Opponent penetrates on a single leg",Range.SHOT,380);addE(es,Threat.ANKLE_PICK,"Opponent reaches an ankle pick under your stance",Range.SHOT,340);}
        // opponent archetype weighting
        if(cfg.opponent.contains("Wrestler")||cfg.opponent.contains("Submission")){addE(es,Threat.DOUBLE_LEG,"Opponent chains punches into a double leg",Range.SHOT,350);addE(es,Threat.COLLAR_TIE,"Opponent enters a hard collar tie",Range.CLINCH,300);}if(cfg.opponent.contains("Long Kicker")||cfg.opponent.contains("Attrition Kicker")){addE(es,Threat.BODY_KICK,"Opponent whips a rear body kick",