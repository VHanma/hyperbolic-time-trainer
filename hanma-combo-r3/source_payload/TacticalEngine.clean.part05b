cale.US).contains("no-gi"))st.range=Range.SCRAMBLE;else st.range=Range.BOXING;st.positionStreak=0;st.cage="CENTER";}}else st.positionStreak=0;if("Pressure Hunt".equals(cfg.mode)&&rnd.nextInt(100)<35)st.cage=rnd.nextBoolean()?"FENCE":"CORNER";if("Ringcraft Round".equals(cfg.mode)&&rnd.nextInt(100)<45)st.cage=rnd.nextBoolean()?"FENCE":"CORNER";}
    private void applyFeedback(String f){String x=f.toUpperCase(Locale.US);int delta=x.contains("CLEAN")?3:x.contains("LATE")?-1:x.contains("BLOCKED")?-1:x.contains("MISSED")?-2:x.contains("COUNTERED")?-4:0;if(delta!=0){for(int i=0;i<lastPlan.size();i++){Action a=lastPlan.get(i);int credit=delta*((i==0?2:1)+(i==lastPlan.size()-1?1:0));actionCredit.put(a.name,Math.max(-30,Math.min(30,actionCredit.getOrDefault(a.name,0)+credit)));String sk=st.range+" | "+(lastDefense==null?"NONE":lastDefense.name)+" | "+a.family;shardQuality.put(sk,Math.max(0,shardQuality.getOrDefault(sk,0)+Math.max(-1,delta)));}st.initiative=Math.max(-6,Math.min(6,st.initiative+(delta>0?1:-1)));st.rivalPressure=Math.max(10,Math.min(95,st.rivalPressure+(delta>0?-4:5));}}

    public String validateKnowledge(){for(Threat t:Threat.values()){if(t==Threat.NONE)continue;if(!defenses.containsKey(t)||defenses.get(t).isEmpty())return "Missing defense for "+t;}if(actions.size()<70)return "R8 action corpus too small: "+actions.size();String dl=String.join("|",DISCIPLINES).toLowerCase(Locale.US);for(String x:new String[]{"boxing","striking","muay thai","mma","sambo","wrestling","no-gi","karate","52"})if(!dl.contains(x))return "Missing discipline "+x;String docs=String.join("|",DOCTRINES).toLowerCase(Locale.US);for(String x:new String[]{"world class","fagan","fighttips","jesse","mma shredded","precision","punch doctor","wittman","benny","michael jai","52","modern martial"})if(!docs.contains(x))return "Missing doctrine "+x;return "";}
    public String sourceLedger(){StringBuilder b=new StringBuilder("R8 Ω SOURCE COVERAGE\n\n");for(Map.Entry<String,String>e:sourceRules.entrySet()){int ac=0,dc=0;for(Action a:actions)if(a.source.equals(e.getKey()))ac++;for(List<Defense>ls:defenses.values())for(Defense d:ls)if(d.source.contains(e.getKey()))dc++;b.append(e.getKey()).append("\n  rule: ").append(e.getValue()).append("\n  executable actions: ").append(ac).append(" • defense branches: ").append(dc).append("\n\n");}b.append("TOTAL ACTIONS: ").append(actions.size()).append("\nDISCIPLINES: ").append(DISCIPLINES.length).append("\nORIGINAL LIBRARY: ").append(libraryCodes.size()).append(" coded + ").append(libraryNamed.size()).append(" named");return b.toString();}

    public String exportCombatState(){StringBuilder b=new StringBuilder("R8|").append(st.range).append('|').append(st.loaded).append('|').append(st.balance).append('|').append(st.guard).append('|').append(st.mobilityDebt).append('|').append(st.initiative).append('|').append(st.rivalPressure).append('|').append(st.cage);appendMap(b,"BEL",opponentBeliefs);appendMap(b,"HAB",userHabits);appendMap(b,"CTX",contextHabits);appendMap(b,"CRD",actionCredit);appendMap(b,"REA",reactionBeliefs);appendMap(b,"PAT",patternMemory);appendMap(b,"SHA",shardAttempts);appendMap(b,"SHQ",shardQuality);appendMap(b,"SHC",shardContextHits);return b.toString();}
    private void appendMap(StringBuilder b,String label,Map<String,Integer>m){b.append('|').append(label).append(':');List<Map.Entry<String,Integer>> es=new ArrayList<>(m.entrySet());es.sort((a,z)->Integer.compare(Math.abs(z.getValue()),Math.abs(a.getValue())));int n=0;for(Map.Entry<String,Integer>x:es){if(n++>=160)break;b.append(cleanKey(x.getKey())).append('=').append(x.getValue()).append(',');}}
    private String cleanKey(String k){return k.replace('|','_').replace(',','_').replace('=','_');}
    private void readMap(String body,Map<String,Integer>out){if(body==null||body.isEmpty())return;for(String item:body.split(",")){int eq=item.lastIndexOf('=');if(eq<=0)continue;try{out.put(item.substring(0,eq),Integer.parseInt(item.substring(eq+1)));}catch(Exception ignored){}}}
    public void importCombatState(String s){if(s==null||(!s.startsWith("R7|")&&!s.startsWith("R8|")))return;try{String[]p=s.split("\\|",-1);boolean r8=s.startsWith("R8|");st.range=Range.valueOf(p[1]);st.loaded=Side.valueOf(p[2]);st.balance=Integer.parseInt(p[3]);st.guard=Integer.parseInt(p[4]);st.mobilityDebt=Integer.parseInt(p[5]);st.initiative=Integer.parseInt(p[6]);int start=7;if(r8&&p.length>8){st.rivalPressure=Integer.parseInt(p[7]);st.cage=p[8];start=9;}for(int i=start;i<p.length;i++){if(p[i].startsWith("BEL:"))readMap(p[i].substring(4),opponentBeliefs);else if(p[i].startsWith("HAB:"))readMap(p[i].substring(4),userHabits);else if(p[i].startsWith("CTX:"))readMap(p[i].substring(4),contextHabits);else if(p[i].startsWith("CRD:"))readMap(p[i].substring(4),actionCredit);