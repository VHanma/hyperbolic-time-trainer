role.equals("TAKEDOWN")){pull+=8;shell+=5;fire+=4;}if(a.role.equals("INTERCEPT")){shoot+=5;fire+=6;}if(a.commitment>=8){shoot-=8;fire-=5;}if(a.role.equals("PROBE")||a.role.equals("FEINT")){shell+=4;pull+=4;shoot+=3;fire+=3;}return Math.min(Math.min(shell,pull),Math.min(shoot,fire))+(shell+pull+shoot+fire)/8;}
    private int actionScore(Action a,SimState s,int window,String purpose){if(!positionalLegal(a,s))return Integer.MIN_VALUE/4;int score=36+loadedBonus(a,s)-recentPenalty(a)+doctrineBonus(a)+profileBonus(a);if(a.minWindow>window)score-=32;score-=Math.max(0,a.mobilityCost+s.mobilityDebt-18);if(purpose.contains("PROBE")&&a.role.equals("PROBE"))score+=22;if((purpose.contains("CONDITION")||purpose.contains("BETRAY"))&&(a.role.equals("DRAW")||a.role.equals("FEINT")||a.role.equals("MORPH")))score+=24;if(purpose.contains("EXPLOIT")&&(a.role.equals("DAMAGE")||a.role.equals("FINISH")))score+=22;if(purpose.contains("ANGLE")&&a.role.equals("ANGLE"))score+=28;if(purpose.contains("STRUCTURE")&&(a.role.equals("ESCAPE")||a.role.equals("CONTROL")))score+=30;if(purpose.contains("CONTROL")&&(a.role.equals("CONTROL")||a.role.equals("ISOLATE")))score+=30;if(cfg.counterfactuals)score+=counterfactualScore(a);if(cfg.doppelganger)score-=Math.min(12,userHabits.getOrDefault(a.name,0)/3);score+=Math.min(10,actionCredit.getOrDefault(a.name,0));return score+rnd.nextInt(18);}
    private boolean noveltyLegal(Action a,List<Action>out){int morph=0;for(Action x:out){if(x.name.equals(a.name))return false;if(x.role.equals("MORPH"))morph++;}if(a.role.equals("MORPH")&&morph>0)return false;if(out.size()>=2&&out.get(out.size()-2).family.equals(a.family))return false;return true;}
    private int nextWindow(Action a){if(a.role.equals("PROBE")||a.role.equals("FEINT")||a.role.equals("DRAW"))return 260;if(a.role.equals("ANGLE")||a.role.equals("CONTROL"))return 250;if(a.role.equals("TAKEDOWN")||a.role.equals("ESCAPE"))return 300;if(a.role.equals("MORPH"))return 190;if(a.role.equals("FINISH"))return 180;return 220;}

    private List<Action> plan(Event e,Defense d,String purpose){SimState sim=st.copy();sim.range=d.endRange;sim.loaded=d.load;sim.balance=Math.min(100,sim.balance+d.balance);sim.guard=Math.min(100,sim.guard+d.guard);List<Action>out=new ArrayList<>();int depth=cfg.difficulty>=9?5:cfg.difficulty>=7?4:cfg.difficulty>=4?3:2,window=e.window,commit=0,debt=0;for(int step=0;step<depth;step++){Action best=null;int bestScore=Integer.MIN_VALUE;for(Action a:actions){if(!noveltyLegal(a,out))continue;int sc=actionScore(a,sim,window,purpose);if(!out.isEmpty()){Action prev=out.get(out.size()-1);if(prev.family.equals(a.family))sc-=16;if(prev.target.equals(a.target)&&(a.role.equals("DAMAGE")||a.role.equals("FINISH")))sc-=6;}if(commit>=14&&!(a.role.equals("ANGLE")||a.role.equals("CONTROL")||a.role.equals("PROBE")))sc-=18;if(debt>=16&&a.mobilityCost>=7)sc-=18;if(sc>bestScore){bestScore=sc;best=a;}else if(best!=null&&sc>=bestScore-12&&rnd.nextInt(100)<55){bestScore=sc;best=a;}}int floor=step==0?-20:step==1?14:step==2?28:38;if(best==null||bestScore<floor)break;if(step>=2&&commit>=18&&!(best.role.equals("ANGLE")||best.role.equals("CONTROL")))break;out.add(best);commit+=best.commitment;debt+=best.mobilityCost;applyAction(sim,best);window=nextWindow(best);if(best.role.equals("TAKEDOWN")||best.role.equals("ESCAPE")||best.role.equals("FINISH"))break;}String sig=signature(out);if(recentPlans.contains(sig)&&out.size()>1)out.remove(out.size()-1);return out;}
    private String signature(List<Action>p){StringBuilder b=new StringBuilder();for(Action a:p){if(b.length()>0)b.append('>');b.append(a.family);}return b.toString();}
    private void rememberPlan(List<Action>p){push(recentPlans,signature(p),80);for(Action a:p){push(recentActions,a.name,40);push(recentFamilies,a.family,32);push(recentSources,a.source,24);}}
    private void push(Deque<String>d,String s,int cap){if(s==null||s.isEmpty())return;d.addLast(s);while(d.size()>cap)d.removeFirst();}
    private void applyAction(SimState s,Action a){Range before=s.range;s.range=a.end;s.loaded=a.loads;s.mobilityDebt=Math.min(35,Math.max(0,s.mobilityDebt+a.mobilityCost-4));s.balance=Math.max(40,Math.min(100,s.balance-a.commitment/2+2));s.guard=Math.max(45,Math.min(100,s.guard-a.commitment/3+1));s.initiative=Math.min(6,s.initiative+1);s.lastUserAction=a.name;s.lastFamily=a.family;if(a.role.equals("ANGLE"))s.cage="ANGLE";if(a.target.equals("BODY"))opponentBeliefs.put("BODY",opponentBeliefs.getOrDefault("BODY",0)+4);if(a.target.equals("HEAD"))opponentBeliefs.put("HEAD",opponentBeliefs.getOrDefault("HEAD",0)+3);userHabits.put(a.name,userHabits.getOrDefault(a.name,0)+1);contextHabits.put(before.name()+"@"+a.name,contextHabits.getOrDefault(before.name()+"@"+a.name,0)+1);}

    private String expectedReply(List<Action>p){if(p.isEm