     public String getGroundState(){return st.range.name();}
     public boolean lastResponseSolvedThreat(){ return lastThreat==Threat.NONE || (lastDefense!=null && lastDefense.threat==lastThreat); }
 
+    /**
+     * Convert visual/legacy notation into words a TTS engine should actually say.
+     * Visual chain arrows mean sequence, while legacy /R/ and /L/ tokens mean slips.
+     */
+    public static String toSpeech(String raw){
+        if(raw==null)return "";
+        String s=raw;
+        s=s.replace("/R/"," slip right ").replace("/L/"," slip left ");
+        s=s.replace("←"," slip left ");
+        s=s.replace("→",", then ").replace("➜",", then ").replace("➡",", then ");
+        s=s.replace("1-2","one two");
+        s=s.replace("Ω","Omega");
+        s=s.replaceAll("\\s+", " ").replaceAll("\\s+,", ",").trim();
+        s=s.replaceAll(",\\s*,+", ", ");
+        return s;
+    }
+
+    public boolean lastPlanHasLoop(){
+        Set<String> seen=new HashSet<>();
+        for(Action a:lastPlan){ if(!seen.add(a.name)) return true; }
+        for(int i=2;i<lastPlan.size();i++) if(lastPlan.get(i).name.equals(lastPlan.get(i-2).name)) return true;
+        return false;
+    }
+    public int lastPlanMorphCount(){int n=0;for(Action a:lastPlan)if(a.role.equals("MORPH"))n++;return n;}
+
     private void resetRoundState(){
         st=new SimState(); st.range=parseRange(cfg.startRange); exchange=0; lastThreat=Threat.NONE; lastDefense=null; lastPlan=Collections.emptyList();
     }
