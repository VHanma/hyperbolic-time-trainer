hardQuality.getOrDefault(k,0);int c=shardContextHits.getOrDefault(k,0);if(!p.isEmpty())c=Math.min(9,c+1);shardContextHits.put(k,c);String level=a>=18&&q>=24&&c>=3?"AUTOMATIC":a>=8?"FORMING":"LEARNING";lastShard=level+" • "+k+" • reps "+a;return lastShard;}
    private String mindText(String purpose,List<Action>p){int head=opponentBeliefs.getOrDefault("HEAD",0),body=opponentBeliefs.getOrDefault("BODY",0);String expect=Math.max(head,body)<8||Math.abs(head-body)<4?"UNCERTAIN":head>body?"HEAD":"BODY";String habit="NONE";int hv=0,prefixLen=(st.range.name()+"@").length();String prefix=st.range.name()+"@";for(Map.Entry<String,Integer>x:contextHabits.entrySet())if(x.getKey().startsWith(prefix)&&x.getValue()>hv){hv=x.getValue();habit=x.getKey().substring(prefixLen);}String next=p.isEmpty()?"RESET":p.get(0).name;return "HE EXPECTS: "+expect+" • YOU LOADED: "+st.loaded+" • PURPOSE: "+purpose+" • BEST LANE: "+next+" • GHOST READ @ "+st.range+": "+habit;}
    private String primitiveTrace(Action a){if(a==null)return "RESET";String n=a.name;if(n.contains("jab"))return "ROOT → STEP/ANCHOR → EXTEND → RETRACT";if(n.contains("cross")||n.contains("straight"))return "REAR DRIVE → HIP ROTATE → TRANSFER → EXTEND → RECOIL";if(n.contains("hook"))return "ROOT → ROTATE → ARC → RECOIL";if(n.contains("uppercut"))return "LOAD → RISE → ROTATE → LIFT → RECOIL";if(n.contains("kick")||n.contains("teep"))return "BASE → PIVOT/DRIVE → HIP → IMPACT → RECOVER";if(n.contains("leg")||n.contains("takedown")||n.contains("pick"))return "LEVEL/CONTACT → CONNECT → DRIVE → TURN → CONTROL";if(n.contains("pass"))return "POSTURE → FRAME/GRIP → HIP ANGLE → CLEAR KNEE → SETTLE";return "BASE → CONNECT → EXECUTE → RECOVER";}
    private String whyText(Event e,Defense d,List<Action>p,String purpose){StringBuilder b=new StringBuilder();b.append("THREAT → ").append(e.threat.name().replace('_',' ')).append("\nSOLUTION → ").append(d.name).append("\nWHY → ").append(d.mechanic).append("\nMECHANICS → loads ").append(d.load).append(", range ").append(d.endRange).append("\nPURPOSE → ").append(purpose);if(!p.isEmpty())b.append("\nFIRST COUNTER WINDOW → ").append(e.window).append(" ms class; first action ").append(p.get(0).name).append("\nPRIMITIVES → ").append(primitiveTrace(p.get(0)));b.append("\nDISCIPLINE → ").append(cfg.discipline).append("\nDOCTRINE → ").append(cfg.doctrine).append("\nSOURCE → ").append(d.source);return b.toString();}
    private String stateText(){return "RANGE "+st.range+" • LOAD "+st.loaded+" • BAL "+st.balance+" • GUARD "+st.guard+" • DEBT "+st.mobilityDebt+" • INIT "+st.initiative+" • RING "+st.cage;}

    public Result next(String feedback){if(feedback!=null)applyFeedback(feedback);exchange++;if("Pure Library".equals(cfg.mode)){String c=libraryNamed.isEmpty()?"Jab → Cross":libraryNamed.get(rnd.nextInt(libraryNamed.size()));lastThreat=Threat.NONE;lastDefense=null;lastPlan=Collections.emptyList();return new Result("PURE LIBRARY",c,"Legacy slot","Original supplied library call","Omega planner bypassed","Original supplied library","LIBRARY","none","none",st.cage,"UNTRACKED","Original Library","UNSET",0);}positionStreakTick();Event e=generateEvent();lastEvent=e.text;lastThreat=e.threat;List<Defense>ds=defenses.get(e.threat);if(ds==null||ds.isEmpty())throw new IllegalStateException("No defense knowledge for "+e.threat);Defense d=chooseDefense(ds);lastDefense=d;String purpose=choosePurpose(e);List<Action>p=plan(e,d,purpose);lastPlan=p;StringBuilder cue=new StringBuilder(d.name);for(Action a:p)cue.append(" → ").append(a.name);st.range=d.endRange;st.loaded=d.load;st.balance=Math.min(100,st.balance+d.balance);st.guard=Math.min(100,st.guard+d.guard);st.lastDefense=d.name;for(Action a:p)applyAction(st,a);st.lastPurpose=purpose;rememberPlan(p);String reply=expectedReply(p),pattern=patternText(),shard=shardText(d,p);String src=p.isEmpty()?d.source:p.get(0).source;return new Result(e.text,cue.toString(),stateText(),whyText(e,d,p,purpose),mindText(purpose,p),src,purpose,reply,queuedReaction,st.cage,shard,cfg.doctrine,pattern,e.window);}
    private Defense chooseDefense(List<Defense>ds){List<Defense>pool=new ArrayList<>();for(Defense d:ds)if(cfg.doctrine==null||cfg.doctrine.startsWith("Ω")||d.source.contains(cfg.doctrine)||cfg.doctrine.contains("Biomechanics")&&d.source.contains("Combat/Biomechanics"))pool.add(d);if(pool.isEmpty())pool=ds;return pool.get(rnd.nextInt(pool.size()));}
    private void positionStreakTick(){if(st.range==Range.TOP_CONTROL||st.range==Range.TOP_GUARD||st.range==Range.BOTTOM){st.positionStreak++;if(st.positionStreak>=4&&rnd.nextInt(100)<45){if(cfg.discipline.toLowerCase(Locale.US).contains("wrestling")||cfg.discipline.toLowerCase(Lo