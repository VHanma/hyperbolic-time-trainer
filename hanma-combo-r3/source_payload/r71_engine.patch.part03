+    private void readMap(String body,Map<String,Integer> out){
+        if(body==null||body.isEmpty())return;
+        for(String item:body.split(",")){
+            int eq=item.lastIndexOf('='); if(eq<=0)continue;
+            try{out.put(item.substring(0,eq),Integer.parseInt(item.substring(eq+1)));}catch(Exception ignored){}
+        }
+    }
